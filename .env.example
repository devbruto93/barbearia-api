DB_USERNAME=barbearia
DB_PASSWORD=troque-por-uma-senha-local
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
DB_PORT=5432
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Compose local: mantenha TLS desativado. Em produção, configure TLS_ENABLED=true
# e coloque o keystore PKCS12 em ./certs/api.p12.
TLS_ENABLED=false
TLS_KEY_STORE_PASSWORD=
# 0 desativa a purga automática até a barbearia definir um prazo de retenção.
DATA_RETENTION_APPOINTMENTS_DAYS=0
PRIVACY_CONTACT_EMAIL=
